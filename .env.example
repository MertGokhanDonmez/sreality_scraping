# Copy this file to .env and fill in your values.
# .env is loaded by run_daily.sh before daily_run.py runs - never commit the
# real .env file (it contains a Gmail App Password).

# Bezrealitky search-result URL to scrape every run.
SEARCH_URL="https://www.bezrealitky.com/search?estateType=BYT&location=exact&offerType=PRONAJEM&priceTo=15000&region=486&roommate=false&currency=CZK"

# Gmail account that sends the mail, and its 16-character App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords).
# A regular Gmail login password will NOT work here.
GMAIL_ADDRESS="youraccount@gmail.com"
GMAIL_APP_PASSWORD="xxxxxxxxxxxxxxxx"

# Who receives the results. Defaults to GMAIL_ADDRESS if omitted.
MAIL_TO="utkubayri.2000@gmail.com"
